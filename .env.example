# Jottr configuration. Copy to .env and edit. All vars are prefixed JOTTR_.

# Public base URL of the app (used to build the OAuth redirect URI).
JOTTR_BASE_URL=http://localhost:8000

# Secret used to sign the session cookie. Use a long random string in prod:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JOTTR_JWT_SECRET=change-me-to-a-long-random-string

# --- Google OAuth ---------------------------------------------------------
# Leave BOTH blank to use the built-in dev login (no Google needed).
# To enable real login, create an OAuth 2.0 Client (Web application) at
# https://console.cloud.google.com/apis/credentials and set the authorized
# redirect URI to  <JOTTR_BASE_URL>/api/auth/callback
JOTTR_GOOGLE_CLIENT_ID=
JOTTR_GOOGLE_CLIENT_SECRET=

# Comma-separated allowlist of emails permitted to sign in (effectively
# single-user). Required once Google OAuth is enabled.
JOTTR_ALLOWED_EMAILS=

# --- Storage --------------------------------------------------------------
# Where the data volume is mounted inside the container. Rarely changed.
JOTTR_DATA_DIR=/data
